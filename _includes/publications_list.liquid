<div class="publications">
  {% bibliography --group_by none %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var list = document.querySelector('.publications');
    var filter = document.querySelector('.publications-filter');
    if (!list || !filter) return;

    var entries = Array.prototype.slice.call(list.querySelectorAll('.row[data-first-author]'));
    var firstAuthor = entries.filter(function (row) {
      return row.dataset.firstAuthor === 'true';
    });

    var summary = document.querySelector('.publications-summary');
    if (summary) {
      var plural = function (n) {
        return n + (n === 1 ? ' paper' : ' papers');
      };
      summary.textContent = plural(entries.length) + ' · ' + firstAuthor.length + ' first-author';
    }

    filter.addEventListener('click', function (event) {
      var button = event.target.closest('button[data-filter]');
      if (!button) return;
      var mode = button.dataset.filter;

      filter.querySelectorAll('button[data-filter]').forEach(function (b) {
        var active = b === button;
        b.classList.toggle('active', active);
        b.setAttribute('aria-pressed', active);
      });

      entries.forEach(function (row) {
        var item = row.closest('li') || row;
        var hide = mode === 'first-author' && row.dataset.firstAuthor !== 'true';
        item.style.display = hide ? 'none' : '';
      });
    });
  });
</script>
